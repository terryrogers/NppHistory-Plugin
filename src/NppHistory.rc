    GROUPBOX "Log file", IDC_LOGGING_FILE_GROUP, 18, 99, 334, 86
    CONTROL "Notepad++ plugin configuration folder", IDC_LOGGING_DEFAULT, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 28, 115, 205, 13
    CONTROL "Custom log file:", IDC_LOGGING_CUSTOM, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 28, 134, 100, 13
