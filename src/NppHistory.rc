IDD_EDIT_COMMENT DIALOGEX 0, 0, 270, 82
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit Revision Comment"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Comment:", -1, 10, 12, 50, 12
    EDITTEXT IDC_EDIT_COMMENT, 10, 29, 250, 16, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER
    DEFPUSHBUTTON "Save", IDOK, 149, 56, 53, 18
    PUSHBUTTON "Cancel", IDCANCEL, 207, 56, 53, 18
END

IDD_ABOUT DIALOGEX 0, 0, 270, 148
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About NppHistory"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "", -1, 10, 10, 250, 109
    CTEXT "NppHistory for Notepad++", -1, 70, 7, 130, 12
    CONTROL "Author: <a href=""https://www.terryrogers.me"">Terry Rogers</a>", IDC_ABOUT_AUTHOR, "SysLink", WS_TABSTOP, 20, 29, 180, 14
    LTEXT "Version:", IDC_ABOUT_VERSION, 20, 48, 180, 12
    LTEXT "Release Date:", IDC_ABOUT_RELEASE_DATE, 20, 67, 180, 12
    LTEXT "Licence: GPL-3.0", -1, 20, 86, 170, 12
    LTEXT "Automatic saving and continuous local revision history.", -1, 20, 103, 205, 12
    ICON IDI_NPPHISTORY, IDC_ABOUT_ICON, 218, 30, 24, 24, SS_REALSIZECONTROL
    DEFPUSHBUTTON "OK", IDOK, 207, 126, 53, 16
END

IDD_COMPARE DIALOGEX 0, 0, 760, 520
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX | WS_MINIMIZEBOX
CAPTION "NppHistory File Compare"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_COMPARE_TOOLBAR, "ToolbarWindow32", WS_CHILD | WS_VISIBLE | TBSTYLE_FLAT | CCS_NODIVIDER | CCS_NORESIZE, 5, 0, 750, 36
    LTEXT "Location Pane", IDC_COMPARE_LOCATION_LABEL, 5, 40, 75, 18, SS_LEFT | SS_CENTERIMAGE
    LTEXT "x", IDC_COMPARE_LOCATION_CLOSE, 78, 40, 14, 18, SS_NOTIFY | SS_CENTER | SS_CENTERIMAGE
    CONTROL "", IDC_COMPARE_LOCATION_MAP, "Static", SS_OWNERDRAW | SS_NOTIFY, 5, 59, 70, 432
    CONTROL "", IDC_COMPARE_LEFT_HEADER, "Static", SS_OWNERDRAW | SS_NOTIFY, 78, 40, 335, 19
    CONTROL "", IDC_COMPARE_RIGHT_HEADER, "Static", SS_OWNERDRAW | SS_NOTIFY, 416, 40, 339, 19
    CONTROL "", IDC_COMPARE_LEFT, "Scintilla", WS_CHILD | WS_VISIBLE | WS_TABSTOP, 78, 59, 335, 411
    CONTROL "", IDC_COMPARE_RIGHT, "Scintilla", WS_CHILD | WS_VISIBLE | WS_TABSTOP, 416, 59, 339, 411
    LTEXT "", IDC_COMPARE_LEFT_STATUS, 78, 470, 335, 20, SS_LEFT | SS_CENTERIMAGE
    LTEXT "", IDC_COMPARE_RIGHT_STATUS, 416, 470, 339, 20, SS_LEFT | SS_CENTERIMAGE
    LTEXT "No differences", IDC_COMPARE_OVERALL_STATUS, 5, 492, 750, 18, SS_RIGHT | SS_CENTERIMAGE

    // Compatibility controls retained off-screen for the existing command and smoke-test IDs.
    COMBOBOX IDC_COMPARE_REVISION, -50, -50, 1, 1, CBS_DROPDOWNLIST
    PUSHBUTTON "", IDC_COMPARE_PREVIOUS, -50, -50, 1, 1
    PUSHBUTTON "", IDC_COMPARE_NEXT, -50, -50, 1, 1
    LTEXT "", IDC_COMPARE_STATUS, -50, -50, 1, 1
    CONTROL "", IDC_COMPARE_IGNORE_WHITESPACE, "Button", BS_AUTOCHECKBOX, -50, -50, 1, 1
    CONTROL "", IDC_COMPARE_IGNORE_BLANK, "Button", BS_AUTOCHECKBOX, -50, -50, 1, 1
    CONTROL "", IDC_COMPARE_IGNORE_CASE, "Button", BS_AUTOCHECKBOX, -50, -50, 1, 1
    CONTROL "", IDC_COMPARE_IGNORE_EOL, "Button", BS_AUTOCHECKBOX, -50, -50, 1, 1
    CONTROL "", IDC_COMPARE_LEFT_MARKERS, "Static", SS_OWNERDRAW, -50, -50, 1, 1
    SCROLLBAR IDC_COMPARE_SCROLL, -50, -50, 1, 1, SBS_VERT
    CONTROL "", IDC_COMPARE_RIGHT_MARKERS, "Static", SS_OWNERDRAW, -50, -50, 1, 1
END
