    CONTROL "Enable revision history", IDC_HISTORY_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 37, 180, 13
    GROUPBOX "Create revisions", IDC_HISTORY_CREATE_GROUP, 18, 55, 334, 68
    CONTROL "Before a file is saved", IDC_HISTORY_BEFORE_SAVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 72, 180, 13
    CONTROL "After a file is saved", IDC_HISTORY_AFTER_SAVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 90, 180, 13
    CONTROL "Before restoring a revision", IDC_HISTORY_BEFORE_RESTORE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 108, 200, 13
    GROUPBOX "History location", IDC_HISTORY_GROUP, 18, 128, 334, 79
    CONTROL "Hidden .npphistory folder beside each file", IDC_HISTORY_ADJACENT, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 28, 145, 260, 13
    CONTROL "Common folder:", IDC_HISTORY_CUSTOM, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 28, 164, 95, 13
    EDITTEXT IDC_HISTORY_PATH, 43, 183, 231, 15, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER
    PUSHBUTTON "Browse...", IDC_HISTORY_BROWSE, 280, 181, 60, 18
    GROUPBOX "Disable revision history for:", IDC_HISTORY_EXCLUSIONS_GROUP, 18, 212, 334, 84
    LTEXT "One wildcard pattern per line", IDC_HISTORY_EXCLUSIONS_NOTE, 28, 229, 180, 12
    EDITTEXT IDC_HISTORY_EXCLUSIONS, 28, 243, 314, 43, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP | WS_BORDER

