    CONTROL "All open files", IDC_AUTOSAVE_ALL_FILES, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 172, 188, 120, 13
    GROUPBOX "Disable Auto Save for:", IDC_AUTOSAVE_EXCLUSIONS_GROUP, 18, 212, 334, 84
    LTEXT "One wildcard pattern per line", IDC_AUTOSAVE_EXCLUSIONS_NOTE, 28, 229, 180, 12
