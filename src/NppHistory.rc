#include <windows.h>
#include "resource.h"
#include "Version.h"

IDB_WINMERGE_TOOLBAR BITMAP "res\\WinMergeToolbar.bmp"
IDI_NPPHISTORY ICON "res\\NppHistory.ico"
IDI_WINMERGE_DIFFERENT_TEXT ICON "res\\WinMergeNotequalTextFile.ico"
IDI_WINMERGE_EQUAL_TEXT ICON "res\\WinMergeEqualTextFile.ico"
IDI_CAPTURE ICON "res\\Capture.ico"
IDI_REFRESH ICON "res\\Refresh.ico"
IDI_COMPARE ICON "res\\Compare.ico"
IDI_RESTORE ICON "res\\Restore.ico"
IDI_SETTINGS ICON "res\\Settings.ico"
IDI_ABOUT ICON "res\\About.ico"
IDI_EDIT ICON "res\\Edit.ico"
IDI_DELETE ICON "res\\Delete.ico"

1 VERSIONINFO
 FILEVERSION 0,2,0,20
 PRODUCTVERSION 0,2,0,20
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x2L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NppHistory contributors\0"
            VALUE "FileDescription", "Automatic save and continuous history for Notepad++\0"
            VALUE "FileVersion", "0.2.0-beta.21\0"
            VALUE "InternalName", "NppHistory\0"
            VALUE "LegalCopyright", "GPL-3.0\0"
            VALUE "OriginalFilename", "NppHistory.dll\0"
            VALUE "ProductName", "NppHistory\0"
            VALUE "ProductVersion", "0.2.0-beta.21\0"
            VALUE "ReleaseDate", NPPHISTORY_RELEASE_DATE "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_HISTORY_PANEL DIALOGEX 0, 0, 360, 260
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "Segoe UI"
BEGIN
    LTEXT "No file selected", IDC_CURRENT_FILE, 7, 7, 346, 20, SS_PATHELLIPSIS
    CONTROL "", IDC_REVISIONS, "SysListView32", WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 7, 30, 346, 190
    PUSHBUTTON "Capture", IDC_CAPTURE, 7, 233, 54, 18
    PUSHBUTTON "Refresh", IDC_REFRESH, 65, 233, 54, 18
    PUSHBUTTON "Compare", IDC_COMPARE, 123, 233, 54, 18
    PUSHBUTTON "Restore", IDC_RESTORE, 181, 233, 54, 18
    PUSHBUTTON "Settings", IDC_PANEL_SETTINGS, 239, 233, 54, 18
    PUSHBUTTON "About", IDC_PANEL_ABOUT, 297, 233, 54, 18
END

IDD_SETTINGS DIALOGEX 0, 0, 330, 245
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "NppHistory Settings"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_SETTINGS_TABS, "SysTabControl32", WS_TABSTOP, 8, 8, 314, 209
    CONTROL "", IDC_SETTINGS_PAGE_BACKGROUND, "Static", SS_WHITERECT, 10, 29, 310, 186

    GROUPBOX "Toolbar", IDC_GENERAL_TOOLBAR_GROUP, 18, 37, 294, 72
    CONTROL "Capture", IDC_TOOLBAR_CAPTURE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 54, 75, 13
    CONTROL "Compare", IDC_TOOLBAR_COMPARE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 123, 54, 75, 13
    CONTROL "Restore", IDC_TOOLBAR_RESTORE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 218, 54, 75, 13
    LTEXT "Add selected commands to the main Notepad++ toolbar.", IDC_TOOLBAR_DESCRIPTION, 28, 75, 270, 12
    LTEXT "Toolbar changes apply after restarting Notepad++.", IDC_TOOLBAR_RESTART_NOTE, 28, 91, 270, 12
    GROUPBOX "Update", IDC_GENERAL_UPDATE_GROUP, 18, 116, 294, 91
    CONTROL "Enable automatic update checks", IDC_AUTO_UPDATE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 134, 180, 13
    LTEXT "Frequency:", IDC_UPDATE_FREQUENCY_LABEL, 28, 157, 55, 12
    COMBOBOX IDC_UPDATE_FREQUENCY, 86, 154, 105, 70, CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL "Include prerelease versions", IDC_UPDATE_PRERELEASES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 181, 155, 13
    PUSHBUTTON "Check now...", IDC_UPDATE_CHECK_NOW, 220, 176, 78, 18

    CONTROL "Enable automatic saving", IDC_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 37, 235, 13
    GROUPBOX "Auto Save when:", IDC_AUTOSAVE_WHEN_GROUP, 18, 55, 294, 115
    CONTROL "After editing stops", IDC_AFTER_EDIT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 74, 118, 13
    EDITTEXT IDC_AFTER_EDIT_SECONDS, 150, 71, 38, 15, ES_NUMBER | WS_TABSTOP | WS_BORDER
    LTEXT "seconds (minimum 10)", IDC_AFTER_EDIT_LABEL, 193, 74, 105, 12
    CONTROL "Notepad++ loses focus", IDC_AUTOSAVE_FOCUS_LOSS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 94, 180, 13
    CONTROL "At timed intervals every", IDC_AUTOSAVE_INTERVAL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 114, 133, 13
    EDITTEXT IDC_AUTOSAVE_INTERVAL_MINUTES, 165, 111, 38, 15, ES_NUMBER | WS_TABSTOP | WS_BORDER
    LTEXT "minutes", IDC_INTERVAL_LABEL, 208, 114, 50, 12
    CONTROL "File tab changes", IDC_AUTOSAVE_TAB_CHANGE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 134, 150, 13
    CONTROL "Notepad++ exits", IDC_AUTOSAVE_EXIT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 154, 150, 13
    GROUPBOX "Auto Save what:", IDC_AUTOSAVE_WHAT_GROUP, 18, 175, 294, 32
    CONTROL "Current file only", IDC_AUTOSAVE_CURRENT_FILE, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 28, 188, 120, 13
    CONTROL "All open files", IDC_AUTOSAVE_ALL_FILES, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 172, 188, 120, 13

    CONTROL "Enable revision history", IDC_HISTORY_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 37, 180, 13
    GROUPBOX "Create revisions", IDC_HISTORY_CREATE_GROUP, 18, 55, 294, 68
    CONTROL "Before a file is saved", IDC_HISTORY_BEFORE_SAVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 72, 180, 13
    CONTROL "After a file is saved", IDC_HISTORY_AFTER_SAVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 90, 180, 13
    CONTROL "Before restoring a revision", IDC_HISTORY_BEFORE_RESTORE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 28, 108, 200, 13
    GROUPBOX "History location", IDC_HISTORY_GROUP, 18, 128, 294, 79
    CONTROL "Hidden .npphistory folder beside each file", IDC_HISTORY_ADJACENT, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 28, 145, 260, 13
    CONTROL "Common folder:", IDC_HISTORY_CUSTOM, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 28, 164, 95, 13
    EDITTEXT IDC_HISTORY_PATH, 43, 183, 191, 15, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER
    PUSHBUTTON "Browse...", IDC_HISTORY_BROWSE, 240, 181, 60, 18

    DEFPUSHBUTTON "OK", IDOK, 211, 222, 53, 18
    PUSHBUTTON "Cancel", IDCANCEL, 269, 222, 53, 18
END

IDD_EDIT_COMMENT DIALOGEX 0, 0, 270, 82
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit Revision Comment"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Comment:", -1, 10, 12, 50, 12
    EDITTEXT IDC_EDIT_COMMENT, 10, 29, 250, 16, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER
    DEFPUSHBUTTON "Save", IDOK, 149, 56, 53, 18
    PUSHBUTTON "Cancel", IDCANCEL, 207, 56, 53, 18
END

IDD_ABOUT DIALOGEX 0, 0, 270, 148
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About NppHistory"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "", -1, 10, 10, 250, 109
    CTEXT "NppHistory for Notepad++", -1, 70, 7, 130, 12
    CONTROL "Author: <a href=""https://www.terryrogers.me"">Terry Rogers</a>", IDC_ABOUT_AUTHOR, "SysLink", WS_TABSTOP, 20, 29, 180, 14
    LTEXT "Version:", IDC_ABOUT_VERSION, 20, 48, 180, 12
    LTEXT "Release Date:", IDC_ABOUT_RELEASE_DATE, 20, 67, 180, 12
    LTEXT "Licence: GPL-3.0", -1, 20, 86, 170, 12
    LTEXT "Automatic saving and continuous local revision history.", -1, 20, 103, 205, 12
    ICON IDI_NPPHISTORY, IDC_ABOUT_ICON, 218, 30, 24, 24, SS_REALSIZECONTROL
    DEFPUSHBUTTON "OK", IDOK, 207, 126, 53, 16
END

IDD_COMPARE DIALOGEX 0, 0, 760, 520
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX | WS_MINIMIZEBOX
CAPTION "NppHistory File Compare"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_COMPARE_TOOLBAR, "ToolbarWindow32", WS_CHILD | WS_VISIBLE | TBSTYLE_FLAT | CCS_NODIVIDER | CCS_NORESIZE, 5, 0, 750, 36
    LTEXT "Location Pane", IDC_COMPARE_LOCATION_LABEL, 5, 40, 75, 18, SS_LEFT | SS_CENTERIMAGE
    LTEXT "x", IDC_COMPARE_LOCATION_CLOSE, 78, 40, 14, 18, SS_NOTIFY | SS_CENTER | SS_CENTERIMAGE
    CONTROL "", IDC_COMPARE_LOCATION_MAP, "Static", SS_OWNERDRAW | SS_NOTIFY, 5, 59, 70, 432
    CONTROL "", IDC_COMPARE_LEFT_HEADER, "Static", SS_OWNERDRAW | SS_NOTIFY, 78, 40, 335, 19
    CONTROL "", IDC_COMPARE_RIGHT_HEADER, "Static", SS_OWNERDRAW | SS_NOTIFY, 416, 40, 339, 19
    CONTROL "", IDC_COMPARE_LEFT, "Scintilla", WS_CHILD | WS_VISIBLE | WS_TABSTOP, 78, 59, 335, 411
    CONTROL "", IDC_COMPARE_RIGHT, "Scintilla", WS_CHILD | WS_VISIBLE | WS_TABSTOP, 416, 59, 339, 411
    LTEXT "", IDC_COMPARE_LEFT_STATUS, 78, 470, 335, 20, SS_LEFT | SS_CENTERIMAGE
    LTEXT "", IDC_COMPARE_RIGHT_STATUS, 416, 470, 339, 20, SS_LEFT | SS_CENTERIMAGE
    LTEXT "No differences", IDC_COMPARE_OVERALL_STATUS, 5, 492, 750, 18, SS_RIGHT | SS_CENTERIMAGE

    // Compatibility controls retained off-screen for the existing command and smoke-test IDs.
    COMBOBOX IDC_COMPARE_REVISION, -50, -50, 1, 1, CBS_DROPDOWNLIST
    PUSHBUTTON "", IDC_COMPARE_PREVIOUS, -50, -50, 1, 1
    PUSHBUTTON "", IDC_COMPARE_NEXT, -50, -50, 1, 1
    LTEXT "", IDC_COMPARE_STATUS, -50, -50, 1, 1
    CONTROL "", IDC_COMPARE_IGNORE_WHITESPACE, "Button", BS_AUTOCHECKBOX, -50, -50, 1, 1
    CONTROL "", IDC_COMPARE_IGNORE_BLANK, "Button", BS_AUTOCHECKBOX, -50, -50, 1, 1
    CONTROL "", IDC_COMPARE_IGNORE_CASE, "Button", BS_AUTOCHECKBOX, -50, -50, 1, 1
    CONTROL "", IDC_COMPARE_IGNORE_EOL, "Button", BS_AUTOCHECKBOX, -50, -50, 1, 1
    CONTROL "", IDC_COMPARE_LEFT_MARKERS, "Static", SS_OWNERDRAW, -50, -50, 1, 1
    SCROLLBAR IDC_COMPARE_SCROLL, -50, -50, 1, 1, SBS_VERT
    CONTROL "", IDC_COMPARE_RIGHT_MARKERS, "Static", SS_OWNERDRAW, -50, -50, 1, 1
END
