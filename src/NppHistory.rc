    LTEXT "", IDC_LOGGING_EFFECTIVE_PATH, 28, 169, 225, 11, SS_PATHELLIPSIS
    PUSHBUTTON "Open Log", IDC_LOGGING_OPEN, 270, 167, 70, 16
    GROUPBOX "Size and rollover", IDC_LOGGING_ROTATION_GROUP, 18, 190, 334, 62
